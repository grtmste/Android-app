{
	"$schema": "https://schemas.wp.org/wp/6.4/theme.json",
	"version": 2,
	"settings": {
		"appearanceTools": true,
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"custom": true,
			"palette": [
				{
					"slug": "primary",
					"name": "Primary",
					"color": "#0B0B0B"
				},
				{
					"slug": "secondary",
					"name": "Secondary",
					"color": "#6B6B6B"
				},
				{
					"slug": "text",
					"name": "Text",
					"color": "#1A1A1A"
				},
				{
					"slug": "accent",
					"name": "Accent",
					"color": "#FF5A1F"
				},
				{
					"slug": "white",
					"name": "White",
					"color": "#FFFFFF"
				},
				{
					"slug": "surface",
					"name": "Surface",
					"color": "#F5F5F5"
				},
				{
					"slug": "border",
					"name": "Border",
					"color": "#E3E3E3"
				},
				{
					"slug": "muted",
					"name": "Muted Dark",
					"color": "#2B2B2B"
				}
			]
		},
		"typography": {
			"fluid": true,
			"defaultFontSizes": false,
			"customFontSize": true,
			"fontFamilies": [
				{
					"slug": "display",
					"name": "Barlow Condensed",
					"fontFamily": "\"Barlow Condensed\", \"Arial Narrow\", Impact, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Barlow Condensed",
							"fontStyle": "normal",
							"fontWeight": "700",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/barlow-condensed-latin-700-normal.woff2"
							]
						},
						{
							"fontFamily": "Barlow Condensed",
							"fontStyle": "normal",
							"fontWeight": "800",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/barlow-condensed-latin-800-normal.woff2"
							]
						}
					]
				},
				{
					"slug": "body",
					"name": "Inter",
					"fontFamily": "Inter, system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Inter",
							"fontStyle": "normal",
							"fontWeight": "400",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/inter-latin-400-normal.woff2"
							]
						},
						{
							"fontFamily": "Inter",
							"fontStyle": "normal",
							"fontWeight": "500",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/inter-latin-500-normal.woff2"
							]
						},
						{
							"fontFamily": "Inter",
							"fontStyle": "normal",
							"fontWeight": "600",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/inter-latin-600-normal.woff2"
							]
						},
						{
							"fontFamily": "Inter",
							"fontStyle": "normal",
							"fontWeight": "700",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/inter-latin-700-normal.woff2"
							]
						}
					]
				}
			],
			"fontSizes": [
				{
					"slug": "small",
					"name": "Small",
					"size": "13px",
					"fluid": false
				},
				{
					"slug": "base",
					"name": "Base",
					"size": "16px",
					"fluid": false
				},
				{
					"slug": "lead",
					"name": "Lead",
					"size": "20px",
					"fluid": {
						"min": "17px",
						"max": "20px"
					}
				},
				{
					"slug": "h3",
					"name": "H3",
					"size": "28px",
					"fluid": {
						"min": "22px",
						"max": "28px"
					}
				},
				{
					"slug": "h2",
					"name": "H2",
					"size": "56px",
					"fluid": {
						"min": "32px",
						"max": "56px"
					}
				},
				{
					"slug": "h1",
					"name": "H1",
					"size": "88px",
					"fluid": {
						"min": "44px",
						"max": "88px"
					}
				},
				{
					"slug": "display",
					"name": "Display",
					"size": "136px",
					"fluid": {
						"min": "56px",
						"max": "136px"
					}
				}
			]
		},
		"spacing": {
			"units": [
				"px",
				"em",
				"rem",
				"vh",
				"vw",
				"%"
			],
			"spacingSizes": [
				{
					"slug": "10",
					"name": "1",
					"size": "4px"
				},
				{
					"slug": "20",
					"name": "2",
					"size": "8px"
				},
				{
					"slug": "30",
					"name": "3",
					"size": "12px"
				},
				{
					"slug": "40",
					"name": "4",
					"size": "16px"
				},
				{
					"slug": "50",
					"name": "5",
					"size": "24px"
				},
				{
					"slug": "60",
					"name": "6",
					"size": "32px"
				},
				{
					"slug": "70",
					"name": "7",
					"size": "48px"
				},
				{
					"slug": "80",
					"name": "8",
					"size": "64px"
				},
				{
					"slug": "90",
					"name": "9",
					"size": "96px"
				},
				{
					"slug": "100",
					"name": "10",
					"size": "128px"
				}
			],
			"padding": true,
			"margin": true,
			"blockGap": true
		},
		"layout": {
			"contentSize": "720px",
			"wideSize": "1200px"
		},
		"shadow": {
			"defaultPresets": false
		},
		"custom": {
			"radius": {
				"pill": "999px",
				"base": "4px"
			},
			"motion": {
				"easeOut": "cubic-bezier(.16, 1, .3, 1)"
			}
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--white)",
			"text": "var(--wp--preset--color--text)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--base)",
			"lineHeight": "1.6"
		},
		"spacing": {
			"blockGap": "24px"
		},
		"elements": {
			"heading": {
				"color": {
					"text": "var(--wp--preset--color--primary)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "800",
					"lineHeight": "0.95",
					"textTransform": "uppercase"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--h-1)"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--h-2)",
					"fontWeight": "700"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--h-3)",
					"fontWeight": "700"
				}
			},
			"link": {
				"color": {
					"text": "inherit"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--accent)"
					}
				}
			},
			"button": {
				"border": {
					"radius": "999px"
				},
				"color": {
					"background": "var(--wp--preset--color--primary)",
					"text": "var(--wp--preset--color--white)"
				},
				"typography": {
					"fontSize": "13px",
					"fontWeight": "700",
					"letterSpacing": "0.06em",
					"textTransform": "uppercase"
				},
				"spacing": {
					"padding": {
						"top": "14px",
						"bottom": "14px",
						"left": "32px",
						"right": "32px"
					}
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--muted)"
					}
				}
			}
		}
	}
}