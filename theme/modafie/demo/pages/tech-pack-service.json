     "_animation_delay": 0
    },
    "elements": []
   },
   {
    "id": "b385af0",
    "elType": "widget",
    "widgetType": "text-editor",
    "isInner": false,
    "settings": {
     "editor": "<p>Our tech pack service is designed for:</p><ul><li>Fashion designers creating their first collection</li><li>Streetwear brands scaling to production</li><li>Entrepreneurs moving from concept to sample</li><li>Existing brands switching manufacturers</li></ul>",
     "__globals__": {
      "typography_typography": "globals/typography?id=text"
     },
     "_animation": "fadeIn",
