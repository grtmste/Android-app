    "elType": "widget",
    "widgetType": "heading",
    "isInner": false,
    "settings": {
     "title": "How It Works",
     "header_size": "h2",
     "_animation": "fadeInUp",
     "_animation_delay": 0
    },
    "elements": []
   },
   {
    "id": "b2b56fc",
    "elType": "widget",
    "widgetType": "text-editor",
    "isInner": false,
    "settings": {
     "editor": "<ul><li>1. You share your design sketches, references, or mood board</li><li>2. We create your complete tech pack</li><li>3. You review and approve</li><li>4. We move straight into sampling — no factory hunting needed</li></ul>",
     "__globals__": {
      "typography_typography": "globals/typography?id=text"
     }
    },
    "elements": []
   }
