     "_animation_delay": 0
    },
    "elements": []
   },
   {
    "id": "d98f6fc",
    "elType": "widget",
    "widgetType": "text-editor",
    "isInner": false,
    "settings": {
     "editor": "<ul><li>Technical flat sketches of your design (front, back, detail views)</li><li>Full measurement spec sheet with size grading</li><li>Fabric and trim specifications</li><li>Stitching and construction details</li><li>Colorway breakdowns</li><li>Label and packaging placement diagrams</li><li>Bill of materials (BOM)</li></ul>",
     "__globals__": {
      "typography_typography": "globals/typography?id=text"
