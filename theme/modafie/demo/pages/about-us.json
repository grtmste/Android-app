   "_title": "Letter — part 1"
  },
  "elements": [
   {
    "id": "34ecd48",
    "elType": "widget",
    "widgetType": "text-editor",
    "isInner": false,
    "settings": {
     "editor": "<p>My name is Monagni. For years, I stood beside friends, colleagues, and strangers with fire in their eyes and sketches in their hands—only to watch that fire dim when they met reality.</p><p>They'd approach factories with 50-unit orders. Laughter.</p><p>They'd beg for 100 pieces. \"Come back when you have 500.\"</p><p>And the ones who compromised? They'd receive garments that looked nothing like their samples. Terrible communication. Zero accountability. And a mountain of inventory they couldn't sell.</p><p>Here's the truth the industry won't tell you:</p>",
     "__globals__": {
      "typography_typography": "globals/typography?id=text"
     },
     "_animation": "fadeIn",
     "_animation_delay": 0
    },
    "elements": []
   }
  ]
 },
